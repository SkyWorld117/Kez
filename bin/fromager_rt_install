#!/usr/bin/env bash

set -Eeuo pipefail

export PATH=${FROMAGER_HOME}/bin:${PATH}

target_cellar=$1
user_config=$2
target_package=$3

rm -rf $target_cellar/.tmp/source $target_cellar/.tmp/source*

fromager_rt_resolve_dependencies "$user_config" "$target_cellar" "$target_package"

# Process each package and its instructions
package_count=$(yq -r '. | length' "$target_cellar/.tmp/filtered_ins.yaml")

# Create state.yaml to store all the installed packages if it doesn't exist
if [ ! -f "$target_cellar/state.yaml" ] || ! $(yq -r ". | has(\"cheese\")" "$target_cellar/state.yaml"); then
    echo "cheese:" > "$target_cellar/state.yaml"
fi

for ((pkg_idx=0; pkg_idx<package_count; pkg_idx++)); do
    # Extract package name
    package_name=$(yq -r ".[$pkg_idx].package" "$target_cellar/.tmp/filtered_ins.yaml")

    fromager_info "Processing package: $package_name"
    cd "$target_cellar/.tmp"

    # Get number of instructions for this package
    instruction_count=$(yq -r ".[$pkg_idx].instructions | length" "$target_cellar/.tmp/filtered_ins.yaml")
    
    # Execute each instruction
    for ((instr_idx=0; instr_idx<instruction_count; instr_idx++)); do
        instruction=$(yq -r ".[$pkg_idx].instructions[$instr_idx]" "$target_cellar/.tmp/filtered_ins.yaml")
        fromager_info "Executing: $instruction"
        saved_pkg_idx=$pkg_idx
        saved_instr_idx=$instr_idx
        eval "$instruction"
        instruction_status=$?
        pkg_idx=$saved_pkg_idx
        instr_idx=$saved_instr_idx
        if [ $instruction_status -ne 0 ]; then
            fromager_error "Failed to execute: $instruction"
            exit 1
        fi
    done

    # Mark package as installed if not already present
    if ! $(grep -q "  - $package_name" "$target_cellar/state.yaml"); then
        echo "  - $package_name" >> "$target_cellar/state.yaml"
    fi

    fromager_success "Completed processing package: $package_name"

    rm -rf "$target_cellar/.tmp/source"
done

set +Eeuo pipefail