#!/usr/bin/env bash

set -Eeuo pipefail

export PATH=${FROMAGER_HOME}/bin:${PATH}

_fgr_eval() {
    local cellar_idx=$1
    local run_config_idx=$2
    local ins_yaml=$3

    local cellar_name=$(yq -r ".[$cellar_idx].name" "${ins_yaml}")
    local run_config_name=$(yq -r ".[$cellar_idx].profiles[$run_config_idx].name" "${ins_yaml}")

    local tasting_room="${FROMAGER_WORKDIR}/factories/${FROMAGER_FACTORY}/tasting_rooms/${cellar_name}_${run_config_name}"
    mkdir -p "${tasting_room}" && cd "${tasting_room}"

    export PATH="${FROMAGER_WORKDIR}/factories/${FROMAGER_FACTORY}/cellars/${cellar_name}/bin:${PATH}"

    local instruction_count=$(yq -r ".[$cellar_idx].profiles[$run_config_idx].instructions | length" "${ins_yaml}")
    for ((k=0; k<instruction_count; k++)); do
        local instruction=$(yq -r ".[$cellar_idx].profiles[$run_config_idx].instructions[$k]" "${ins_yaml}")
        fromager_info "Executing: $instruction"
        eval "$instruction"
        if [ $? -ne 0 ]; then
            fromager_error "Failed to execute: $instruction"
            exit 1
        fi
    done
}

factory_dir="${FROMAGER_WORKDIR}/factories/${FROMAGER_FACTORY}"
config_file="${factory_dir}/tasting_rooms/config.yaml"

if [ ! -f "${config_file}" ]; then
    fromager_error "RT profile config file not found: ${config_file}"
    exit 1
fi

fromager_rt_profile_config_parser "${config_file}" "${factory_dir}/tasting_rooms"
ins_yaml="${factory_dir}/tasting_rooms/ins.yaml"

cellar_count=$(yq -r '. | length' "${ins_yaml}")

for ((i=0; i<cellar_count; i++)); do
    cellar_name=$(yq -r ".[$i].name" "${ins_yaml}")
    run_configs_count=$(yq -r ".[$i].profiles | length" "${ins_yaml}")
    for ((j=0; j<run_configs_count; j++)); do
        run_config_name=$(yq -r ".[$i].profiles[$j].name" "${ins_yaml}")
        fromager_info "Processing cellar: ${cellar_name}, run config: ${run_config_name}"

        ( _fgr_eval "$i" "$j" "${ins_yaml}" )

        fromager_success "Completed processing for cellar: ${cellar_name}, run config: ${run_config_name}"
    done
done

set +Eeuo pipefail