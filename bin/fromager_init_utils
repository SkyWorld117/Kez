#!/usr/bin/env bash

check_installation() {
    local pkg="$1"
    if $(yq -r ".cheese | has(\"${pkg}\")" "${SYSTEM_PREFIX}/state.yaml") &&
       $(yq -r ".cheese.${pkg} | has(\"version\")" "${SYSTEM_PREFIX}/state.yaml"); then
        return 1
    else
        return 0
    fi
}

fetch_latest_web() {
    local pkg="$1"
    local url="$2"
    local ext="${3:-tar.xz}"

    if ! check_installation "${pkg}"; then
        return 0
    fi

    local latest=$(curl -sSL "$url" \
        | grep -oE "${pkg}-[0-9]+\.[0-9]+(\.[0-9]+)?\.${ext}" \
        | sort -Vu \
        | tail -n1)

    if [[ -z "$latest" ]]; then
        echo >&2 "No files found for ${pkg} with extension .${ext} at $url"
        return 1
    fi

    wget --quiet --show-progress --output-document="${FROMAGER_WORKDIR}/.tmp/${latest}" "${url}${latest}"

    # Check if the file was downloaded successfully
    if [ ! -f "${FROMAGER_WORKDIR}/.tmp/${latest}" ]; then
        echo >&2 "Failed to download ${latest} from ${url}"
        return 1
    fi

    if [ ${ext} = "tar.xz" ]; then
        tar -xf "${latest}"
    elif [ ${ext} = "tar.gz" ]; then
        tar -xzf "${latest}"
    elif [ ${ext} = "tar.bz2" ]; then
        tar -xjf "${latest}"
    else
        echo >&2 "Unsupported file extension: ${ext}"
        return 1
    fi

    local version="${latest#${pkg}-}"
    version="${version%.${ext}}"

    echo "${latest%.tar.*}::${version}"
}

fetch_latest_gnu() {
    local pkg="$1"
    local ext="${2:-tar.xz}"
    # GNU official
    # local url="https://ftp.gnu.org/gnu/${pkg}/"
    # GNU mirror (usually much faster)
    local url="https://ftpmirror.gnu.org/gnu/${pkg}/"

    echo $(fetch_latest_web "${pkg}" "${url}" "${ext}")
}

fetch_latest_github() {
    local repo="$1"

    local pkg="${repo##*/}"
    if ! check_installation "${pkg}"; then
        return 0
    fi

    local tag=$(curl -s "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null | jq -r '.tag_name' 2>/dev/null)
    
    if [[ -z "$tag" || "$tag" == "null" ]]; then
        warn "Could not fetch latest version for ${repo}, using fallback"
        return 1
    fi

    wget --quiet --show-progress --output-document="${FROMAGER_WORKDIR}/.tmp/${pkg}-${tag}.tar.gz" "https://github.com/${repo}/archive/refs/tags/${tag}.tar.gz"

    # Check if the file was downloaded successfully
    if [ ! -f "${FROMAGER_WORKDIR}/.tmp/${pkg}-${tag}.tar.gz" ]; then
        echo >&2 "Failed to download ${pkg} version ${tag} from GitHub"
        return 1
    fi

    tar -xzf "${FROMAGER_WORKDIR}/.tmp/${pkg}-${tag}.tar.gz"

    local version="${tag#v}"
    echo "${pkg}-${tag#v}::${version}"
}

fetch_latest_isl() {
    local url="https://libisl.sourceforge.io/"
    local ext="${1:-tar.xz}"

    echo $(fetch_latest_web "isl" "${url}" "${ext}")
}

fetch_latest_elfutils() {
    if ! check_installation "elfutils"; then
        return 0
    fi

    wget --quiet --show-progress --output-document="${FROMAGER_WORKDIR}/.tmp/elfutils.bz2" "https://sourceware.org/elfutils/ftp/elfutils-latest.tar.bz2"

    # Check if the file was downloaded successfully
    if [ ! -f "${FROMAGER_WORKDIR}/.tmp/elfutils.bz2" ]; then
        echo >&2 "Failed to download elfutils from sourceware.org"
        return 1
    fi

    bzip2 -d "${FROMAGER_WORKDIR}/.tmp/elfutils.bz2"
    tar -xf "${FROMAGER_WORKDIR}/.tmp/elfutils" && cd "${FROMAGER_WORKDIR}/.tmp/elfutils"-*

    local version=$(grep -oP 'Version: \K[0-9]+\.[0-9]+' elfutils.spec)
    echo "${version}"
}

fetch_latest_perl() {
    local url="https://www.cpan.org/src/5.0/"
    local ext="tar.gz"

    echo $(fetch_latest_web "perl" "${url}" "${ext}")
}
