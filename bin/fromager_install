#!/usr/bin/env bash

set -Eeuo pipefail

FGR_INFO=${FROMAGER_HOME}/bin/colored_io/fromager_info
FGR_WARNING=${FROMAGER_HOME}/bin/colored_io/fromager_warning
FGR_ERROR=${FROMAGER_HOME}/bin/colored_io/fromager_error
FGR_SUCCESS=${FROMAGER_HOME}/bin/colored_io/fromager_success

target_cellar=$1

force=false
if [ -n "${2:-}" ] && [ "$2" == "--force" ]; then
    force=true
fi

rm -rf $target_cellar/.tmp/source $target_cellar/.tmp/source*

# Process each package and its instructions
package_count=$(yq -r '. | length' "$target_cellar/.tmp/ins.yaml")

# Create state.yaml to store all the installed packages if it doesn't exist
if [ ! -f "$target_cellar/state.yaml" ] || ! $(yq -r ". | has(\"cheese\")" "$target_cellar/state.yaml") || [ "$force" == true ]; then
    echo "cheese:" > "$target_cellar/state.yaml"
fi

for ((pkg_idx=0; pkg_idx<package_count; pkg_idx++)); do
    # Extract package name
    package_name=$(yq -r ".[$pkg_idx].package" "$target_cellar/.tmp/ins.yaml")

    # Skip if package is already installed (unless --force is used)
    if $(grep -q "  - $package_name" "$target_cellar/state.yaml") && [ "$force" == false ]; then
        ${FGR_WARNING} "Package $package_name is already installed. Skipping."
        continue
    fi

    ${FGR_INFO} "Processing package: $package_name"
    cd "$target_cellar/.tmp"

    # Get number of instructions for this package
    instruction_count=$(yq -r ".[$pkg_idx].instructions | length" "$target_cellar/.tmp/ins.yaml")
    
    # Execute each instruction
    for ((instr_idx=0; instr_idx<instruction_count; instr_idx++)); do
        instruction=$(yq -r ".[$pkg_idx].instructions[$instr_idx]" "$target_cellar/.tmp/ins.yaml")
        ${FGR_INFO} "Executing: $instruction"
        saved_pkg_idx=$pkg_idx
        saved_instr_idx=$instr_idx
        eval "$instruction"
        instruction_status=$?
        pkg_idx=$saved_pkg_idx
        instr_idx=$saved_instr_idx
        if [ $instruction_status -ne 0 ]; then
            ${FGR_ERROR} "Failed to execute: $instruction"
            exit 1
        fi
    done

    # Mark package as installed
    echo "  - $package_name" >> "$target_cellar/state.yaml"
    
    ${FGR_SUCCESS} "Completed processing package: $package_name"

    rm -rf "$target_cellar/.tmp/source"
done

# If a module file is not created in the modulefiles directory, create a module file for the cellar
modulefiles_dir=${FROMAGER_WORKDIR}/$(yq -r '.fromager.paths.modulefiles' "${FROMAGER_WORKDIR}/config.yaml")
if [ ! -f "$modulefiles_dir/$(basename $target_cellar)" ]; then
    ${FGR_INFO} "Creating module file for cellar: $target_cellar in $modulefiles_dir"
    cat <<EOF > "$modulefiles_dir/$(basename $target_cellar)"
#%Module1.0
proc ModulesHelp { } {
    puts stderr "This module loads the $(basename $target_cellar) cellar environment."
}
module-whatis "Loads the $(basename $target_cellar) cellar environment"
setenv FROMAGER_CELLAR "$(basename $target_cellar)"
prepend-path PATH "$target_cellar/bin"
EOF
    ${FGR_SUCCESS} "Module file created for cellar: $target_cellar in $modulefiles_dir"
else
    ${FGR_INFO} "Module file already exists for cellar: $target_cellar in $modulefiles_dir. Skipping creation."
fi

set +Eeuo pipefail