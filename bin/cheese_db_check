#!/usr/bin/env bash

set -Eeuo pipefail

# This script uses the `bin/cheese_config_verifier` to check the database correctness file by file.

echo "Starting database check..."

file_list=$(find "${CHEESE_DB}" -type f -name "*.yaml" | sort)
for file in $file_list; do
    echo "Checking file: $file"
    if ! cheese_config_verifier "$file"; then
        echo "Error: Verification failed for $file"
        exit 1
    fi
done

set +Eeuo pipefail