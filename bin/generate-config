#!/bin/bash
#
# Cheese Toolchain Configuration Generator
# This script generates a portable crosstool-NG configuration file
# with automatic architecture detection and kernel version matching
#

set -euo pipefail

# Configuration paths
TEMPLATE_FILE="${CHEESE_DB}/.config.template"
OUTPUT_FILE="${CHEESE_WORKDIR}/.tmp/.config"

# Color output functions
info() { echo -e "\033[32m[INFO]\033[0m $*"; }
warn() { echo -e "\033[33m[WARN]\033[0m $*"; }
error() { echo -e "\033[31m[ERROR]\033[0m $*"; }

# Fetch latest GNU package version (based on cheese_init logic)
fetch_latest_gnu_version() {
    local pkg="$1"
    local ext="${2:-tar.gz}"
    local url="https://ftpmirror.gnu.org/gnu/${pkg}/"
    
    # Get listing and extract filenames (exact same logic as cheese_init)
    local latest
    latest=$(curl -sSL "$url" 2>/dev/null \
        | grep -oE "${pkg}-[0-9]+\.[0-9]+(\.[0-9]+)?\.${ext}" \
        | sort -Vu \
        | tail -n1)
    
    if [[ -z "$latest" ]]; then
        warn "Could not fetch latest version for ${pkg}, using fallback"
        return 1
    fi
    
    # Extract version from filename (remove package name and extension)
    local version
    version=$(echo "$latest" | sed "s/${pkg}-//g" | sed "s/\.${ext}//g")
    
    echo "$version"
}

# Fetch latest GitHub release version
fetch_latest_github_version() {
    local repo="$1"
    local tag
    tag=$(curl -s "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null | jq -r '.tag_name' 2>/dev/null)
    
    if [[ -z "$tag" || "$tag" == "null" ]]; then
        warn "Could not fetch latest version for ${repo}, using fallback"
        return 1
    fi
    
    # Remove 'v' prefix if present
    echo "$tag" | sed 's/^v//'
}

# Fetch latest ISL version from official site
fetch_latest_isl_version() {
    local url="https://libisl.sourceforge.io/"
    local latest
    latest=$(curl -sSL "$url" 2>/dev/null \
        | grep -oE "isl-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar" \
        | sed "s/isl-//g" \
        | sed "s/\.tar//g" \
        | sort -V \
        | tail -n1)
    
    if [[ -z "$latest" ]]; then
        # Fallback: try GitHub releases
        latest=$(curl -s "https://api.github.com/repos/Meinersbur/isl/releases/latest" 2>/dev/null | jq -r '.tag_name' 2>/dev/null | sed 's/^isl-//')
    fi
    
    if [[ -z "$latest" || "$latest" == "null" ]]; then
        warn "Could not fetch latest ISL version, using fallback"
        return 1
    fi
    
    echo "$latest"
}

# Fetch latest kernel version
fetch_latest_kernel_version() {
    local current_kernel="$1"
    local major minor
    major=$(echo "$current_kernel" | cut -d'.' -f1)
    minor=$(echo "$current_kernel" | cut -d'.' -f2)
    
    # Try to get the latest stable version for the same major.minor
    local latest
    latest=$(curl -sSL "https://www.kernel.org/releases.json" 2>/dev/null \
        | jq -r ".releases[] | select(.version | startswith(\"${major}.${minor}\")) | .version" 2>/dev/null \
        | head -n1)
    
    if [[ -z "$latest" || "$latest" == "null" ]]; then
        # Fallback to detected kernel version
        echo "$current_kernel"
    else
        echo "$latest"
    fi
}

# Generate version selection macro for a package
generate_version_selection() {
    local package="$1"
    local version="$2"
    local package_upper="${package^^}"
    
    # Convert version to crosstool-NG format (replace dots with underscores)
    local version_key
    version_key=$(echo "$version" | sed 's/\./_/g')
    
    # Generate the version selection line
    echo "CT_${package_upper}_V_${version_key}=y"
}

# Generate version constraints for a package
generate_version_constraints() {
    local package="$1"
    local version="$2"
    local package_upper="${package^^}"
    
    # Parse version components
    local major minor patch
    IFS='.' read -r major minor patch <<< "$version"
    [[ -z "$patch" ]] && patch="0"
    
    local constraints=""
    
    # Common version thresholds for different packages
    case "$package" in
        "binutils")
            local thresholds=("2.41" "2.39" "2.30" "2.27" "2.26")
            ;;
        "glibc")
            local thresholds=("2.17")
            ;;
        "gcc")
            local thresholds=("11" "6")
            ;;
        "gdb")
            local thresholds=("16" "8.3")
            ;;
        *)
            # Skip constraints for other packages
            return
            ;;
    esac
    
    # Generate constraints
    for threshold in "${thresholds[@]}"; do
        local t_major t_minor
        IFS='.' read -r t_major t_minor <<< "$threshold"
        [[ -z "$t_minor" ]] && t_minor="0"
        
        # Compare versions
        if (( major > t_major || (major == t_major && minor >= t_minor) )); then
            local threshold_key
            threshold_key=$(echo "$threshold" | sed 's/\./_/g')
            constraints+="CT_${package_upper}_later_than_${threshold_key}=y"$'\n'
            constraints+="CT_${package_upper}_${threshold_key}_or_later=y"$'\n'
        fi
    done
    
    echo -n "$constraints"
}

# Detect package versions
detect_package_versions() {
    local versions=""
    
    info "Detecting latest package versions..." >&2
    
    # GNU packages
    local binutils_version glibc_version gcc_version gdb_version
    local gmp_version mpfr_version mpc_version gettext_version libiconv_version
    local ncurses_version expat_version
    
    binutils_version=$(fetch_latest_gnu_version "binutils" "tar.xz" || echo "2.43.1")
    glibc_version=$(fetch_latest_gnu_version "glibc" "tar.xz" || echo "2.41")
    gdb_version=$(fetch_latest_gnu_version "gdb" "tar.xz" || echo "16.2")
    gmp_version=$(fetch_latest_gnu_version "gmp" "tar.xz" || echo "6.3.0")
    mpfr_version=$(fetch_latest_gnu_version "mpfr" "tar.xz" || echo "4.2.1")
    mpc_version=$(fetch_latest_gnu_version "mpc" "tar.gz" || echo "1.3.1")
    gettext_version=$(fetch_latest_gnu_version "gettext" "tar.xz" || echo "0.23.1")
    libiconv_version=$(fetch_latest_gnu_version "libiconv" "tar.gz" || echo "1.16")
    ncurses_version=$(fetch_latest_gnu_version "ncurses" "tar.gz" || echo "6.4")
    
    # Special cases
    local isl_version zlib_version zstd_version expat_version
    isl_version=$(fetch_latest_isl_version || echo "0.26")
    zlib_version=$(fetch_latest_github_version "madler/zlib" || echo "1.3.1")
    zstd_version=$(fetch_latest_github_version "facebook/zstd" || echo "1.5.6")
    
    # Expat from GitHub
    expat_version=$(fetch_latest_github_version "libexpat/libexpat" || echo "2.5.0")
    # Remove 'R_' prefix and replace underscores with dots for expat
    expat_version=$(echo "$expat_version" | sed 's/^R_//' | sed 's/_/./g')
    
    # GCC 11.x.x - find latest 11.x version
    local gcc_version
    gcc_version=$(curl -sSL "https://ftpmirror.gnu.org/gnu/gcc/" 2>/dev/null \
        | grep -oE "gcc-11\.[0-9]+(\.[0-9]+)?\.tar" \
        | sed "s/gcc-//g" \
        | sed "s/\.tar//g" \
        | sort -V \
        | tail -n1)
    
    if [[ -z "$gcc_version" ]]; then
        gcc_version="11.5.0"
    fi
    
    info "Detected versions:" >&2
    info "  binutils: $binutils_version" >&2
    info "  glibc: $glibc_version" >&2
    info "  gcc: $gcc_version" >&2
    info "  gdb: $gdb_version" >&2
    info "  gmp: $gmp_version" >&2
    info "  mpfr: $mpfr_version" >&2
    info "  mpc: $mpc_version" >&2
    info "  isl: $isl_version" >&2
    info "  gettext: $gettext_version" >&2
    info "  libiconv: $libiconv_version" >&2
    info "  ncurses: $ncurses_version" >&2
    info "  expat: $expat_version" >&2
    info "  zlib: $zlib_version" >&2
    info "  zstd: $zstd_version" >&2
    
    # Return versions as environment variables format
    echo "BINUTILS_VERSION=\"$binutils_version\""
    echo "GLIBC_VERSION=\"$glibc_version\""
    echo "GCC_VERSION=\"$gcc_version\""
    echo "GDB_VERSION=\"$gdb_version\""
    echo "GMP_VERSION=\"$gmp_version\""
    echo "MPFR_VERSION=\"$mpfr_version\""
    echo "MPC_VERSION=\"$mpc_version\""
    echo "ISL_VERSION=\"$isl_version\""
    echo "GETTEXT_VERSION=\"$gettext_version\""
    echo "LIBICONV_VERSION=\"$libiconv_version\""
    echo "NCURSES_VERSION=\"$ncurses_version\""
    echo "EXPAT_VERSION=\"$expat_version\""
    echo "ZLIB_VERSION=\"$zlib_version\""
    echo "ZSTD_VERSION=\"$zstd_version\""
}

# Detect system capabilities for CT_CONFIGURE options
detect_configure_options() {
    local configure_opts=""
    
    # Check for C++11 support
    if command -v g++ >/dev/null 2>&1; then
        if g++ -std=c++11 -x c++ -c /dev/null -o /dev/null 2>/dev/null; then
            configure_opts+="CT_CONFIGURE_has_cxx11=y"$'\n'
        fi
    fi
    
    # Check for download tools
    if command -v wget >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_wget=y"$'\n'
    fi
    if command -v curl >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_curl=y"$'\n'
    fi
    
    # Check for build tools
    if command -v ninja >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_ninja=y"$'\n'
    fi
    
    # Check make version
    if command -v make >/dev/null 2>&1; then
        local make_version
        make_version=$(make --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$make_version" ]]; then
            local major minor
            major=$(echo "$make_version" | cut -d'.' -f1)
            minor=$(echo "$make_version" | cut -d'.' -f2)
            
            # Check for make 3.81 or newer
            if (( major > 3 || (major == 3 && minor >= 81) )); then
                configure_opts+="CT_CONFIGURE_has_make_3_81_or_newer=y"$'\n'
            fi
            
            # Check for make 4.0 or newer
            if (( major >= 4 )); then
                configure_opts+="CT_CONFIGURE_has_make_4_0_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for libtool
    if command -v libtool >/dev/null 2>&1; then
        local libtool_version
        libtool_version=$(libtool --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$libtool_version" ]]; then
            local major minor
            major=$(echo "$libtool_version" | cut -d'.' -f1)
            minor=$(echo "$libtool_version" | cut -d'.' -f2)
            
            # Check for libtool 2.4 or newer
            if (( major > 2 || (major == 2 && minor >= 4) )); then
                configure_opts+="CT_CONFIGURE_has_libtool_2_4_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for libtoolize
    if command -v libtoolize >/dev/null 2>&1; then
        local libtoolize_version
        libtoolize_version=$(libtoolize --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$libtoolize_version" ]]; then
            local major minor
            major=$(echo "$libtoolize_version" | cut -d'.' -f1)
            minor=$(echo "$libtoolize_version" | cut -d'.' -f2)
            
            # Check for libtoolize 2.4 or newer
            if (( major > 2 || (major == 2 && minor >= 4) )); then
                configure_opts+="CT_CONFIGURE_has_libtoolize_2_4_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for autoconf
    if command -v autoconf >/dev/null 2>&1; then
        local autoconf_version
        autoconf_version=$(autoconf --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$autoconf_version" ]]; then
            local major minor
            major=$(echo "$autoconf_version" | cut -d'.' -f1)
            minor=$(echo "$autoconf_version" | cut -d'.' -f2)
            
            # Check for autoconf 2.65 or newer
            if (( major > 2 || (major == 2 && minor >= 65) )); then
                configure_opts+="CT_CONFIGURE_has_autoconf_2_65_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for autoreconf
    if command -v autoreconf >/dev/null 2>&1; then
        local autoreconf_version
        autoreconf_version=$(autoreconf --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$autoreconf_version" ]]; then
            local major minor
            major=$(echo "$autoreconf_version" | cut -d'.' -f1)
            minor=$(echo "$autoreconf_version" | cut -d'.' -f2)
            
            # Check for autoreconf 2.65 or newer
            if (( major > 2 || (major == 2 && minor >= 65) )); then
                configure_opts+="CT_CONFIGURE_has_autoreconf_2_65_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for automake
    if command -v automake >/dev/null 2>&1; then
        local automake_version
        automake_version=$(automake --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$automake_version" ]]; then
            local major minor
            major=$(echo "$automake_version" | cut -d'.' -f1)
            minor=$(echo "$automake_version" | cut -d'.' -f2)
            
            # Check for automake 1.15 or newer
            if (( major > 1 || (major == 1 && minor >= 15) )); then
                configure_opts+="CT_CONFIGURE_has_automake_1_15_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for GNU m4
    if command -v m4 >/dev/null 2>&1; then
        local m4_version
        m4_version=$(m4 --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$m4_version" ]]; then
            local major minor patch
            major=$(echo "$m4_version" | cut -d'.' -f1)
            minor=$(echo "$m4_version" | cut -d'.' -f2)
            patch=$(echo "$m4_version" | cut -d'.' -f3)
            
            # Check for GNU m4 1.4.12 or newer
            if (( major > 1 || (major == 1 && minor > 4) || (major == 1 && minor == 4 && patch >= 12) )); then
                configure_opts+="CT_CONFIGURE_has_gnu_m4_1_4_12_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for Python
    if command -v python3 >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_python=y"$'\n'
        
        local python_version
        python_version=$(python3 --version 2>/dev/null | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$python_version" ]]; then
            local major minor
            major=$(echo "$python_version" | cut -d'.' -f1)
            minor=$(echo "$python_version" | cut -d'.' -f2)
            
            # Check for Python 3.4 or newer
            if (( major > 3 || (major == 3 && minor >= 4) )); then
                configure_opts+="CT_CONFIGURE_has_python_3_4_or_newer=y"$'\n'
            fi
        fi
    elif command -v python >/dev/null 2>&1; then
        # Fallback to python command
        local python_version
        python_version=$(python --version 2>&1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$python_version" ]]; then
            local major
            major=$(echo "$python_version" | cut -d'.' -f1)
            if (( major >= 3 )); then
                configure_opts+="CT_CONFIGURE_has_python=y"$'\n'
                configure_opts+="CT_CONFIGURE_has_python_3_4_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for bison
    if command -v bison >/dev/null 2>&1; then
        local bison_version
        bison_version=$(bison --version 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+' | head -1)
        if [[ -n "$bison_version" ]]; then
            local major minor
            major=$(echo "$bison_version" | cut -d'.' -f1)
            minor=$(echo "$bison_version" | cut -d'.' -f2)
            
            # Check for bison 2.7 or newer
            if (( major > 2 || (major == 2 && minor >= 7) )); then
                configure_opts+="CT_CONFIGURE_has_bison_2_7_or_newer=y"$'\n'
            fi
            
            # Check for bison 3.0.4 or newer
            if (( major > 3 || (major == 3 && minor >= 0) )); then
                # Assume 3.0.4+ if major.minor >= 3.0
                configure_opts+="CT_CONFIGURE_has_bison_3_0_4_or_newer=y"$'\n'
            fi
        fi
    fi
    
    # Check for version control
    if command -v git >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_git=y"$'\n'
    fi
    if command -v svn >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_svn=y"$'\n'
    fi
    
    # Check for hash tools
    if command -v md5sum >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_md5sum=y"$'\n'
    fi
    if command -v sha1sum >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_sha1sum=y"$'\n'
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_sha256sum=y"$'\n'
    fi
    if command -v sha512sum >/dev/null 2>&1; then
        configure_opts+="CT_CONFIGURE_has_sha512sum=y"$'\n'
    fi
    
    # Check for install with strip support
    if command -v install >/dev/null 2>&1; then
        if install --help 2>&1 | grep -q -- '--strip-program'; then
            configure_opts+="CT_CONFIGURE_has_install_with_strip_program=y"$'\n'
        fi
    fi
    
    echo "$configure_opts"
}

# Detect system architecture
detect_architecture() {
    local arch
    arch=$(uname -m)
    
    case "$arch" in
        x86_64)
            echo "x86_64"
            ;;
        aarch64|arm64)
            echo "aarch64"
            ;;
        *)
            error "Unsupported architecture: $arch"
            error "Only x86_64 and aarch64 are supported"
            exit 1
            ;;
    esac
}

# Detect optimal microarchitecture for x86_64
detect_x86_64_microarch() {
    local cpu_info="/proc/cpuinfo"
    local march=""
    
    # Check for CPU features to determine optimal -march
    if grep -q "avx512" "$cpu_info"; then
        if grep -q "Intel" "$cpu_info"; then
            march="skylake-avx512"
        else
            march="znver4"  # AMD Zen 4
        fi
    elif grep -q "avx2" "$cpu_info"; then
        if grep -q "Intel" "$cpu_info"; then
            march="haswell"
        else
            march="znver3"  # AMD Zen 3
        fi
    elif grep -q "avx" "$cpu_info"; then
        if grep -q "Intel" "$cpu_info"; then
            march="sandybridge"
        else
            march="znver1"  # AMD Zen
        fi
    else
        march="x86-64"  # Generic x86_64
    fi
    
    echo "$march"
}

# Detect optimal microarchitecture for aarch64
detect_aarch64_microarch() {
    local cpu_info="/proc/cpuinfo"
    local march=""
    
    # Try to detect specific ARM processor
    if grep -q "Cortex-A78" "$cpu_info"; then
        march="cortex-a78"
    elif grep -q "Cortex-A76" "$cpu_info"; then
        march="cortex-a76"
    elif grep -q "Cortex-A75" "$cpu_info"; then
        march="cortex-a75"
    elif grep -q "Cortex-A72" "$cpu_info"; then
        march="cortex-a72"
    elif grep -q "Cortex-A57" "$cpu_info"; then
        march="cortex-a57"
    else
        march="armv8-a"  # Generic ARMv8
    fi
    
    echo "$march"
}

# Get system kernel version
get_kernel_version() {
    local kernel_version
    kernel_version=$(uname -r | cut -d'-' -f1)
    
    # Extract major.minor version
    local major minor
    major=$(echo "$kernel_version" | cut -d'.' -f1)
    minor=$(echo "$kernel_version" | cut -d'.' -f2)
    
    echo "${major}.${minor}"
}

# Generate kernel version configuration
generate_kernel_config() {
    local kernel_version="$1"
    local major minor
    major=$(echo "$kernel_version" | cut -d'.' -f1)
    minor=$(echo "$kernel_version" | cut -d'.' -f2)
    
    # Generate version selection (crosstool-NG format)
    local version_config="CT_LINUX_V_${major}_${minor}=y"
    
    # Generate version constraints
    local constraints=""
    for v in 6.13 6.12 6.11 6.10 6.9 6.8 6.7 6.6 6.5 6.4 6.3 6.2 6.1 6.0 5.19 5.18 5.17 5.16 5.15 5.14 5.13 5.12 5.11 5.10; do
        local v_major v_minor
        v_major=$(echo "$v" | cut -d'.' -f1)
        v_minor=$(echo "$v" | cut -d'.' -f2)
        
        # Compare versions
        if (( major > v_major || (major == v_major && minor >= v_minor) )); then
            constraints+="CT_LINUX_later_than_${v_major}_${v_minor}=y"$'\n'
            constraints+="CT_LINUX_${v_major}_${v_minor}_or_later=y"$'\n'
        fi
    done
    
    echo -e "${version_config}\n${constraints}"
}

# Generate architecture configuration
generate_arch_config() {
    local arch="$1"
    local tune="$2"
    
    case "$arch" in
        x86_64)
            cat <<EOF
CT_ARCH_X86=y
CT_ARCH_X86_SHOW=y
CT_ARCH_X86_PKG_KSYM=""
CT_ALL_ARCH_CHOICES="ALPHA ARC ARM AVR BPF C6X LM32 LOONGARCH M68K MICROBLAZE MIPS MOXIE MSP430 NIOS2 OPENRISC PARISC POWERPC PRU RISCV S390 SH SPARC TRICORE X86 XTENSA"
CT_ARCH_SUFFIX=""
EOF
            ;;
        aarch64)
            cat <<EOF
CT_ARCH_ARM=y
CT_ARCH_ARM_SHOW=y
CT_ARCH_ARM_PKG_KSYM=""
CT_ALL_ARCH_CHOICES="ALPHA ARC ARM AVR BPF C6X LM32 LOONGARCH M68K MICROBLAZE MIPS MOXIE MSP430 NIOS2 OPENRISC PARISC POWERPC PRU RISCV S390 SH SPARC TRICORE X86 XTENSA"
CT_ARCH_SUFFIX=""
CT_ARCH_ARM_MODE_ARM=y
CT_ARCH_ARM_MODE="arm"
CT_ARCH_ARM_EABI_FORCE=y
CT_ARCH_ARM_EABI=y
CT_ARCH_64=y
CT_ARCH_BITNESS=64
EOF
            ;;
    esac
}

# Main configuration generation
generate_config() {
    local force_arch="${1:-}"
    local force_kernel="${2:-}"
    local no_version_check="${3:-false}"
    local force_gcc_version="${4:-}"
    local force_binutils_version="${5:-}"
    local force_glibc_version="${6:-}"
    local force_gdb_version="${7:-}"
    
    info "Generating crosstool-NG configuration for Cheese package manager..."
    
    # Detect system capabilities
    info "Detecting system capabilities..."
    local configure_options
    configure_options=$(detect_configure_options)
    
    # Detect package versions (unless disabled)
    if [[ "$no_version_check" == "false" ]]; then
        local package_versions
        package_versions=$(detect_package_versions)
        eval "$package_versions"  # Set version variables
        
        # Override forced versions
        if [[ -n "$force_gcc_version" ]]; then
            info "Using forced GCC version: $force_gcc_version"
            GCC_VERSION="$force_gcc_version"
        fi
        if [[ -n "$force_binutils_version" ]]; then
            info "Using forced binutils version: $force_binutils_version"
            BINUTILS_VERSION="$force_binutils_version"
        fi
        if [[ -n "$force_glibc_version" ]]; then
            info "Using forced glibc version: $force_glibc_version"
            GLIBC_VERSION="$force_glibc_version"
        fi
        if [[ -n "$force_gdb_version" ]]; then
            info "Using forced GDB version: $force_gdb_version"
            GDB_VERSION="$force_gdb_version"
        fi
    else
        info "Skipping version detection, using template defaults"
        # Set fallback versions
        BINUTILS_VERSION="2.43.1"
        GLIBC_VERSION="2.41"
        GCC_VERSION="${force_gcc_version:-11.5.0}"
        GDB_VERSION="16.2"
        GMP_VERSION="6.3.0"
        MPFR_VERSION="4.2.1"
        MPC_VERSION="1.3.1"
        ISL_VERSION="0.26"
        GETTEXT_VERSION="0.23.1"
        LIBICONV_VERSION="1.16"
        NCURSES_VERSION="6.4"
        EXPAT_VERSION="2.5.0"
        ZLIB_VERSION="1.3.1"
        ZSTD_VERSION="1.5.6"
    fi
    
    # Detect or use forced architecture
    local target_arch
    if [[ -n "$force_arch" ]]; then
        target_arch="$force_arch"
        info "Using forced architecture: $target_arch"
    else
        target_arch=$(detect_architecture)
        info "Detected architecture: $target_arch"
    fi
    
    # Detect microarchitecture tuning
    local target_tune
    case "$target_arch" in
        x86_64)
            target_tune=$(detect_x86_64_microarch)
            ;;
        aarch64)
            target_tune=$(detect_aarch64_microarch)
            ;;
    esac
    info "Detected microarchitecture: $target_tune"
    
    # Detect or use forced kernel version
    local kernel_version
    if [[ -n "$force_kernel" ]]; then
        kernel_version="$force_kernel"
        info "Using forced kernel version: $kernel_version"
    else
        kernel_version=$(get_kernel_version)
        # Try to get latest stable for this kernel series (unless version check disabled)
        if [[ "$no_version_check" == "false" ]]; then
            kernel_version=$(fetch_latest_kernel_version "$kernel_version")
        fi
        info "Using kernel version: $kernel_version"
    fi
    
    # Generate configurations
    local arch_config
    arch_config=$(generate_arch_config "$target_arch" "$target_tune")
    
    local kernel_config
    kernel_config=$(generate_kernel_config "$kernel_version")
    
    local version_config
    version_config=$(echo "$kernel_config" | head -1)
    
    local version_constraints
    version_constraints=$(echo "$kernel_config" | tail -n +2)
    
    # Generate version selections and constraints
    local binutils_selection glibc_selection gcc_selection gdb_selection
    local expat_selection gettext_selection gmp_selection isl_selection
    local libiconv_selection mpc_selection mpfr_selection ncurses_selection
    local zlib_selection zstd_selection
    
    local binutils_constraints glibc_constraints gcc_constraints gdb_constraints
    
    binutils_selection=$(generate_version_selection "binutils" "$BINUTILS_VERSION")
    binutils_constraints=$(generate_version_constraints "binutils" "$BINUTILS_VERSION")
    
    glibc_selection=$(generate_version_selection "glibc" "$GLIBC_VERSION")
    glibc_constraints=$(generate_version_constraints "glibc" "$GLIBC_VERSION")
    
    gcc_selection=$(generate_version_selection "gcc" "$GCC_VERSION")
    gcc_constraints=$(generate_version_constraints "gcc" "$GCC_VERSION")
    
    gdb_selection=$(generate_version_selection "gdb" "$GDB_VERSION")
    gdb_constraints=$(generate_version_constraints "gdb" "$GDB_VERSION")
    
    expat_selection=$(generate_version_selection "expat" "$EXPAT_VERSION")
    gettext_selection=$(generate_version_selection "gettext" "$GETTEXT_VERSION")
    gmp_selection=$(generate_version_selection "gmp" "$GMP_VERSION")
    isl_selection=$(generate_version_selection "isl" "$ISL_VERSION")
    libiconv_selection=$(generate_version_selection "libiconv" "$LIBICONV_VERSION")
    mpc_selection=$(generate_version_selection "mpc" "$MPC_VERSION")
    mpfr_selection=$(generate_version_selection "mpfr" "$MPFR_VERSION")
    ncurses_selection=$(generate_version_selection "ncurses" "$NCURSES_VERSION")
    zlib_selection=$(generate_version_selection "zlib" "$ZLIB_VERSION")
    zstd_selection=$(generate_version_selection "zstd" "$ZSTD_VERSION")

    # Check if template exists
    if [[ ! -f "$TEMPLATE_FILE" ]]; then
        error "Template file not found: $TEMPLATE_FILE"
        exit 1
    fi
    
    # Generate the configuration file
    info "Generating configuration file: $OUTPUT_FILE"
    
    # Create temporary files for complex multi-line replacements
    local temp_file
    temp_file=$(mktemp)
    cp "$TEMPLATE_FILE" "$temp_file"
    
    # Function to safely replace placeholders with multi-line content
    replace_placeholder() {
        local placeholder="$1"
        local content="$2"
        local temp_replacement
        temp_replacement=$(mktemp)
        local temp_output
        temp_output=$(mktemp)
        
        # Write content to temporary file
        printf '%s' "$content" > "$temp_replacement"
        
        # Use awk for robust replacement that handles newlines and special characters
        awk -v placeholder="$placeholder" -v replacement_file="$temp_replacement" '
        BEGIN {
            # Read replacement content
            replacement = ""
            first_line = 1
            while ((getline line < replacement_file) > 0) {
                if (!first_line) {
                    replacement = replacement "\n"
                }
                replacement = replacement line
                first_line = 0
            }
            close(replacement_file)
        }
        {
            # Replace placeholder with replacement content
            gsub(placeholder, replacement)
            print
        }' "$temp_file" > "$temp_output"
        
        # Move result back to temp_file
        mv "$temp_output" "$temp_file"
        
        rm -f "$temp_replacement"
    }
    
    # Replace complex multi-line placeholders first
    replace_placeholder "{{CT_CONFIGURE_OPTIONS}}" "$configure_options"
    replace_placeholder "{{ARCH_CONFIG}}" "$arch_config"
    replace_placeholder "{{LINUX_VERSION_CONSTRAINTS}}" "$version_constraints"
    replace_placeholder "{{BINUTILS_VERSION_CONSTRAINTS}}" "$binutils_constraints"
    replace_placeholder "{{GLIBC_VERSION_CONSTRAINTS}}" "$glibc_constraints"
    replace_placeholder "{{GCC_VERSION_CONSTRAINTS}}" "$gcc_constraints"
    replace_placeholder "{{GDB_VERSION_CONSTRAINTS}}" "$gdb_constraints"
    
    # Convert architecture to crosstool-NG format
    local ct_arch ct_arch_upper
    case "$target_arch" in
        x86_64)
            ct_arch="x86"
            ct_arch_upper="X86"
            ;;
        aarch64)
            ct_arch="arm"
            ct_arch_upper="ARM"
            ;;
        *)
            ct_arch="$target_arch"
            ct_arch_upper="${target_arch^^}"
            ;;
    esac
    
    # Replace simple single-line placeholders with sed
    sed \
        -e "s|{{TARGET_ARCH}}|$ct_arch|g" \
        -e "s|{{TARGET_ARCH_UPPER}}|$ct_arch_upper|g" \
        -e "s|{{TARGET_TUNE}}|$target_tune|g" \
        -e "s|{{KERNEL_TYPE}}|linux|g" \
        -e "s|{{KERNEL_VERSION}}|$kernel_version|g" \
        -e "s|{{LINUX_VERSION_CONFIG}}|$version_config|g" \
        -e "s|{{BINUTILS_TYPE}}|binutils|g" \
        -e "s|{{BINUTILS_VERSION_SELECTION}}|$binutils_selection|g" \
        -e "s|{{BINUTILS_VERSION}}|$BINUTILS_VERSION|g" \
        -e "s|{{GLIBC_VERSION_SELECTION}}|$glibc_selection|g" \
        -e "s|{{GLIBC_VERSION}}|$GLIBC_VERSION|g" \
        -e "s|{{CC_TYPE}}|gcc|g" \
        -e "s|{{GCC_VERSION_SELECTION}}|$gcc_selection|g" \
        -e "s|{{GCC_VERSION}}|$GCC_VERSION|g" \
        -e "s|{{GDB_VERSION_SELECTION}}|$gdb_selection|g" \
        -e "s|{{GDB_VERSION}}|$GDB_VERSION|g" \
        -e "s|{{EXPAT_VERSION_SELECTION}}|$expat_selection|g" \
        -e "s|{{EXPAT_VERSION}}|$EXPAT_VERSION|g" \
        -e "s|{{GETTEXT_VERSION_SELECTION}}|$gettext_selection|g" \
        -e "s|{{GETTEXT_VERSION}}|$GETTEXT_VERSION|g" \
        -e "s|{{GMP_VERSION_SELECTION}}|$gmp_selection|g" \
        -e "s|{{GMP_VERSION}}|$GMP_VERSION|g" \
        -e "s|{{ISL_VERSION_SELECTION}}|$isl_selection|g" \
        -e "s|{{ISL_VERSION}}|$ISL_VERSION|g" \
        -e "s|{{LIBICONV_VERSION_SELECTION}}|$libiconv_selection|g" \
        -e "s|{{LIBICONV_VERSION}}|$LIBICONV_VERSION|g" \
        -e "s|{{MPC_VERSION_SELECTION}}|$mpc_selection|g" \
        -e "s|{{MPC_VERSION}}|$MPC_VERSION|g" \
        -e "s|{{MPFR_VERSION_SELECTION}}|$mpfr_selection|g" \
        -e "s|{{MPFR_VERSION}}|$MPFR_VERSION|g" \
        -e "s|{{NCURSES_VERSION_SELECTION}}|$ncurses_selection|g" \
        -e "s|{{NCURSES_VERSION}}|$NCURSES_VERSION|g" \
        -e "s|{{ZLIB_VERSION_SELECTION}}|$zlib_selection|g" \
        -e "s|{{ZLIB_VERSION}}|$ZLIB_VERSION|g" \
        -e "s|{{ZSTD_VERSION_SELECTION}}|$zstd_selection|g" \
        -e "s|{{ZSTD_VERSION}}|$ZSTD_VERSION|g" \
        "$temp_file" > "$OUTPUT_FILE"
    
    # Clean up temporary file
    rm -f "$temp_file"
    
    info "Configuration file generated successfully!"
    info "Architecture: $target_arch"
    info "Microarchitecture: $target_tune"
    info "Kernel version: $kernel_version"
    info "GCC version: $GCC_VERSION"
    info "Output file: $OUTPUT_FILE"
}

# Show usage information
usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Generate a crosstool-NG configuration file for Cheese package manager.

OPTIONS:
    -a, --arch ARCH         Force architecture (x86_64, aarch64)
    -k, --kernel VERSION    Force kernel version (e.g., 6.1, 5.15)
    --no-version-check      Skip dynamic version detection (use template defaults)
    --gcc-version VERSION   Force specific GCC version (default: latest 11.x)
    --binutils-version VER  Force specific binutils version
    --glibc-version VER     Force specific glibc version
    --gdb-version VER       Force specific GDB version
    -h, --help             Show this help message

If no options are provided, the script will auto-detect system settings and fetch
latest package versions from upstream sources.

Examples:
    $0                          # Auto-detect everything with latest versions
    $0 -a x86_64               # Force x86_64 architecture
    $0 -k 6.1                  # Force kernel version 6.1
    $0 --no-version-check      # Use hardcoded template versions
    $0 --gcc-version 11.4.0    # Force specific GCC version
    $0 --binutils-version 2.42 # Force specific binutils version
    $0 --glibc-version 2.40     # Force specific glibc version

EOF
}

# Parse command line arguments
main() {
    local force_arch=""
    local force_kernel=""
    local no_version_check=false
    local force_gcc_version=""
    local force_binutils_version=""
    local force_glibc_version=""
    local force_gdb_version=""
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -a|--arch)
                force_arch="$2"
                shift 2
                ;;
            -k|--kernel)
                force_kernel="$2"
                shift 2
                ;;
            --no-version-check)
                no_version_check=true
                shift
                ;;
            --gcc-version)
                force_gcc_version="$2"
                shift 2
                ;;
            --binutils-version)
                force_binutils_version="$2"
                shift 2
                ;;
            --glibc-version)
                force_glibc_version="$2"
                shift 2
                ;;
            --gdb-version)
                force_gdb_version="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
    
    # Check for required tools
    local missing_tools=()
    for tool in curl jq wget tar sed grep cut sort; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
    
    if [[ ${#missing_tools[@]} -gt 0 ]]; then
        error "Missing required tools: ${missing_tools[*]}"
        error "Please install these tools before running this script"
        exit 1
    fi
    
    # Validate forced architecture
    if [[ -n "$force_arch" && "$force_arch" != "x86_64" && "$force_arch" != "aarch64" ]]; then
        error "Invalid architecture: $force_arch"
        error "Supported architectures: x86_64, aarch64"
        exit 1
    fi
    
    # Validate forced kernel version format
    if [[ -n "$force_kernel" && ! "$force_kernel" =~ ^[0-9]+\.[0-9]+$ ]]; then
        error "Invalid kernel version format: $force_kernel"
        error "Expected format: major.minor (e.g., 6.1, 5.15)"
        exit 1
    fi
    
    generate_config "$force_arch" "$force_kernel" "$no_version_check" "$force_gcc_version" "$force_binutils_version" "$force_glibc_version" "$force_gdb_version"
}

# Run main function if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
