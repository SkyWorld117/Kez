#!/usr/bin/env bash

set -Eeuo pipefail

# This script uses the `bin/fromager_config_verifier` to check the database correctness file by file.

export PATH=${FROMAGER_HOME}/bin:${PATH}

fromager_info "Starting database check..."

file_list=$(find "${FROMAGER_DB}" -type f -name "*.yaml" | sort)
for file in $file_list; do
    fromager_info "Checking file: $file"
    if ! fromager_config_verifier "$file"; then
        fromager_error "Verification failed for $file"
        exit 1
    fi
done

set +Eeuo pipefail